# Copy to .env.local
NEXT_PUBLIC_API_URL=http://localhost:4000
# Canonical site origin used for SEO metadata, canonical URLs, and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for the worker → POST /api/revalidate webhook (must match the
# worker's REVALIDATE_SECRET).
REVALIDATE_SECRET=dev-revalidate-secret
# Extra hosts next/image may optimize (comma-separated; API + site hosts built in).
# Official IPL headshots used on /squad, plus article artwork from the feed:
NEXT_PUBLIC_IMAGE_HOSTS=documents.iplt20.com,d1zakxcsliwds.cloudfront.net,www.iplt20.com,images.ctfassets.net
# Extra hostnames allowed to load /_next/image through the hotlink guard
# (comma-separated; same-origin and no-Referer requests are always allowed).
# Edge middleware inlines env at build time — set this before `next build`.
# IMAGE_HOTLINK_ALLOWED_HOSTS=
