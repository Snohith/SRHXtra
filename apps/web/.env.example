# Copy to .env.local
NEXT_PUBLIC_API_URL=http://localhost:4000
# Canonical site origin used for SEO metadata, canonical URLs, and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for the worker → POST /api/revalidate webhook (must match the
# worker's REVALIDATE_SECRET).
REVALIDATE_SECRET=dev-revalidate-secret
# Extra hosts next/image may optimize (comma-separated; API + site hosts built in).
NEXT_PUBLIC_IMAGE_HOSTS=
