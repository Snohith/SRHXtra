# Copy to .env
API_PORT=4000
DATABASE_URL=postgresql://srh:srh_dev_password@localhost:5432/srh_news
# Staff API credential for /api/v1/admin/* (Bearer or x-admin-token).
ADMIN_API_TOKEN=dev-admin-token
# Extra browser origins allowed to call the API (localhost:3000/3001 built in).
CORS_ORIGINS=

# --- Step 5: media + observability ---------------------------------------------
# local (default): signed PUTs stored under <repo>/uploads, served at /uploads/*
# s3: presigned S3-compatible PUTs (bucket must allow PUT from the admin origin)
MEDIA_DRIVER=local
# HMAC key for local upload tickets; falls back to ADMIN_API_TOKEN.
MEDIA_SIGNING_SECRET=
# Public origin of the API — used to build asset URLs returned to clients.
API_PUBLIC_URL=http://localhost:4000
# Optional override of the on-disk uploads directory (default <repo>/uploads)
# UPLOADS_DIR=

# Optional alert webhook for 5xx errors (see README "Monitoring").
ERROR_WEBHOOK_URL=

# S3 driver values (MEDIA_DRIVER=s3) — any S3-compatible store (AWS, MinIO, R2)
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# S3_BUCKET=srh-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=eu-west-1
# S3_FORCE_PATH_STYLE=false      # true for MinIO/R2
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# --- Outbox worker (pnpm worker) — typically set in the root .env -------------
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=dev-revalidate-secret   # must match the web app
# OUTBOX_POLL_MS=2000
