{
  "name": "srh-news",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@srh/web --parallel",
    "dev:admin": "turbo run dev --filter=@srh/admin --parallel",
    "dev:api": "turbo run dev --filter=@srh/api --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "worker": "node apps/api/dist/worker.js",
    "backup": "node scripts/backup.mjs",
    "restore:test": "node scripts/restore-test.mjs",
    "uptime:check": "node scripts/uptime-check.mjs",
    "security:check": "node scripts/security-check.mjs",
    "security:auth": "node scripts/auth-redteam.mjs",
    "e2e": "pnpm --filter @srh/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
