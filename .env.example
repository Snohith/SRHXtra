# Copy to .env and adjust. Each app also has its own .env.example.
POSTGRES_USER=srh
POSTGRES_PASSWORD=srh_dev_password
POSTGRES_DB=srh_news
POSTGRES_PORT=5432
DATABASE_URL=postgresql://srh:srh_dev_password@localhost:5432/srh_news

# API
API_PORT=4000
# Bootstrap credential for the seeded admin (Bearer or x-admin-token).
# Dev default is "dev-admin-token"; set a real secret in production.
# Staff get their own tokens: pnpm --filter @srh/api staff:token <email>
ADMIN_API_TOKEN=dev-admin-token
# Generate one with: openssl rand -hex 32
# Production refuses to boot with the dev default (see apps/api/src/main.ts).
# Comma-separated extra browser origins allowed to call the API
# (localhost:3000 + :3001 are always allowed).
CORS_ORIGINS=
# Rate limits key on req.ip. Behind nginx/Cloudflare set the number of trusted
# proxy hops (e.g. 1) or an IP/subnet list; leave empty when the API is exposed
# directly (otherwise clients can spoof X-Forwarded-For).
TRUST_PROXY=

# Web (public)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL_ADMIN=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Step 5: publishing pipeline ----------------------------------------------
# Shared secret for the worker → web revalidation webhook.
# Production: openssl rand -hex 32 — must match the same value in the web env.
REVALIDATE_SECRET=dev-revalidate-secret
# Outbox worker (`pnpm worker`; loads this file when started from the repo root)
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
OUTBOX_POLL_MS=2000
# Optional Slack-compatible webhook for API 5xx errors, worker failures,
# permanently FAILED outbox events, and `pnpm uptime:check` failures.
ERROR_WEBHOOK_URL=

# --- Media storage (signed uploads) -------------------------------------------
# local (default): signed PUTs stored on disk under ./uploads (served at /uploads/*)
# s3: presigned SigV4 PUTs straight to the bucket (see apps/api/.env.example)
MEDIA_DRIVER=local
# HMAC key for local upload tickets; falls back to ADMIN_API_TOKEN.
MEDIA_SIGNING_SECRET=
# Public origin the API serves uploads from (used in asset URLs).
API_PUBLIC_URL=http://localhost:4000

# --- Backups (scripts read the shell environment; .env is not auto-loaded) ----
# Custom-format pg_dump files land here (default ./backups).
BACKUP_DIR=
BACKUP_KEEP=7
