# Copy to .env and adjust. Each app also has its own .env.example.
POSTGRES_USER=srh
POSTGRES_PASSWORD=srh_dev_password
POSTGRES_DB=srh_news
POSTGRES_PORT=5432
DATABASE_URL=postgresql://srh:srh_dev_password@localhost:5432/srh_news

# API
API_PORT=4000
# Staff API credential for /api/v1/admin/* (Bearer or x-admin-token).
# MVP dev default is "dev-admin-token" — set a real secret per environment.
ADMIN_API_TOKEN=dev-admin-token
# Generate one with: openssl rand -hex 32
# Production refuses to boot with the dev default (see apps/api/src/main.ts).
# Comma-separated extra browser origins allowed to call the API
# (localhost:3000 + :3001 are always allowed).
CORS_ORIGINS=

# Web (public)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL_ADMIN=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
